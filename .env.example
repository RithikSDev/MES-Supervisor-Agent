# Copy to .env (git-ignored) and fill in. docker compose reads .env automatically; never commit real values.
# Wrap values in single quotes if they contain $ or spaces, e.g. SERVICENOW_PASSWORD='pa$$ word'.
# Check the ServiceNow / Jira connection: docker compose exec itsm-adapter-api python -m itsm_adapter.setup

# rest (default): ServiceNow Table API + Jira Cloud REST v3.  mcp: MCP servers (SERVICENOW_MCP_* / JIRA_MCP_*).
ITSM_MODE=rest

# --- ServiceNow and Jira: set up in the admin UI (Integrations -> ServiceNow / Jira), not here.
# Their password / API token are stored encrypted with this key. Create it once (written here, never shown):
#   cd services/itsm-adapter && uv run python -m itsm_adapter.keygen
# Keep it: with another key the stored secrets can't be read (enter them again in the UI then).
ITSM_SECRET_KEY=
# only *.service-now.com / *.servicenowservices.com and *.atlassian.net unless true (e.g. an on-premise instance)
ITSM_ALLOW_ANY_HOST=false
# ServiceNow integration user: a dedicated user (e.g. mes.integration) with role itil that can read sys_user_group
# and sys_journal_field. Jira: account e-mail + API token (id.atlassian.com -> Security -> API tokens).
# Older setups: SERVICENOW_INSTANCE_URL / _USER / _PASSWORD and JIRA_SITE_URL / _EMAIL / _API_TOKEN here are imported
# once into the UI settings when none are stored yet; remove them from .env afterwards.

# --- AI support agent (Claude). Key from console.anthropic.com -> API keys. Without it the agent stays idle.
ANTHROPIC_API_KEY=
# optional: AGENT_MODEL=claude-opus-5   AGENT_EFFORT_TICKET=high   AGENT_EFFORT_CHAT=medium
# L1 = the AI agent's ServiceNow assignment group: set it in the UI connection (e.g. "MES AI Support")

# --- Alerts (notifier). Default: the bundled Mailpit catches all mail (http://localhost:8025). For real mail:
# SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_STARTTLS=true  SMTP_USER=...  SMTP_PASSWORD=...  SMTP_FROM=...
# Teams: a channel's Workflows "post to a channel when a webhook request is received" URL (optional)
TEAMS_WEBHOOK_URL=

# --- MCP mode only
SERVICENOW_MCP_URL=
SERVICENOW_MCP_KEY=
JIRA_MCP_URL=
JIRA_MCP_KEY=

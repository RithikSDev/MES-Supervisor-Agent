          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Op No"
        },
        "required_qty": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Required Qty"
        },
        "uom": {
          "title": "Uom",
          "type": "string"
        },
        "reservation_no": {
          "title": "Reservation No",
          "type": "string"
        },
        "reservation_item": {
          "title": "Reservation Item",
          "type": "string"
        },
        "storage_location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Storage Location"
        },
        "backflush": {
          "default": false,
          "title": "Backflush",
          "type": "boolean"
        },
        "withdrawn_qty": {
